+<form #form="ngForm" (ngSubmit)="save(form)" novalidate>
+  <div class="editor-heading">
+    <div><span class="eyebrow">МОЯ БИБЛИОТЕКА</span><h2 mat-dialog-title>{{ editing ? 'Редактировать книгу' : 'Новая книга' }}</h2></div>
+    <button type="button" class="icon-button" [disabled]="saving" (click)="requestClose()" aria-label="Закрыть"><mat-icon>close</mat-icon></button>
+  </div>
+  <mat-dialog-content>
+    <fieldset [disabled]="saving">
+      <label>Название <span aria-hidden="true">*</span>
+        <input name="title" [(ngModel)]="book.title" required maxlength="300" placeholder="Например, Мастер и Маргарита" autocomplete="off" [attr.aria-invalid]="submitted && !book.title.trim()" />
+      </label>
+      <span class="field-error" *ngIf="submitted && !book.title.trim()">Введите название книги.</span>
+      <label>Автор <span aria-hidden="true">*</span>
+        <input name="author" [(ngModel)]="book.author" required maxlength="200" placeholder="Имя автора" autocomplete="off" [attr.aria-invalid]="submitted && !book.author.trim()" />
+      </label>
+      <span class="field-error" *ngIf="submitted && !book.author.trim()">Укажите автора.</span>
+      <div class="form-row">
+        <label>Статус<select name="status" [(ngModel)]="book.status"><option *ngFor="let status of statuses" [ngValue]="status.code">{{ status.name }}</option></select></label>
+        <label>Жанр<input name="genre" [(ngModel)]="book.genre" maxlength="100" placeholder="Например, фантастика" /></label>
+      </div>
+      <div class="form-row">
+        <label>Всего страниц<input name="totalPages" type="number" [(ngModel)]="book.totalPages" min="1" max="100000" step="1" placeholder="Неизвестно" #total="ngModel" /></label>
+        <label>Прочитано страниц<input name="pagesRead" type="number" [(ngModel)]="book.pagesRead" required min="0" max="100000" step="1" #read="ngModel" [disabled]="book.status === 'COMPLETED' && book.totalPages !== null" /></label>
+      </div>
+      <p class="field-hint" *ngIf="book.status === 'COMPLETED' && book.totalPages !== null">Для прочитанной книги прогресс сохранится как {{ book.totalPages }} из {{ book.totalPages }} страниц.</p>
+      <p class="field-error" *ngIf="(submitted || total.dirty || read.dirty) && (total.invalid || read.invalid || pagesInvalid || progressInvalid)">Укажите целое число страниц: всего от 1 до 100 000, прочитано от 0 до общего количества.</p>
+      <label>Моя оценка<select name="rating" [(ngModel)]="book.rating"><option [ngValue]="null">Без оценки</option><option *ngFor="let rating of [5,4,3,2,1]" [ngValue]="rating">{{ rating }} из 5</option></select></label>
+      <label>Заметки<textarea name="notes" [(ngModel)]="book.notes" rows="3" maxlength="5000" placeholder="Впечатления, любимые цитаты или почему хочется прочитать"></textarea></label>
+    </fieldset>
+    <p class="save-error" role="alert" *ngIf="error">{{ error }}</p>
+    <a class="login-link" *ngIf="sessionExpired" href="/login" target="_blank" rel="noopener">Войти в новой вкладке ↗</a>
+    <div #discardNotice class="save-error discard-confirm" role="alert" tabindex="-1" *ngIf="confirmDiscard">
+      <p>Изменения ещё не сохранены. Закрыть форму?</p>
+      <button type="button" class="secondary" (click)="confirmDiscard = false">Продолжить редактирование</button>
+      <button type="button" class="secondary" [disabled]="saving" (click)="dialog.close()">Выйти без сохранения</button>
+    </div>
+  </mat-dialog-content>
+  <mat-dialog-actions align="end">
+    <button type="button" class="secondary" (click)="requestClose()" [disabled]="saving">Отмена</button>
+    <button type="submit" class="primary" [disabled]="saving">{{ saving ? 'Сохранение…' : 'Сохранить книгу' }}</button>
+  </mat-dialog-actions>
+</form>

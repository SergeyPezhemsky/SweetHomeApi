+.editor-heading { display: flex; justify-content: space-between; align-items: center; padding: 0 12px 12px; gap: 12px; }
+.eyebrow { font-size: 10px; letter-spacing: .15em; color: $color-accent-soft; font-weight: 800; }
+h2[mat-dialog-title] { padding: 4px 0 0; margin: 0; color: inherit; font: 700 23px 'Manrope', sans-serif; }
+h2[mat-dialog-title]::before { display: none; }

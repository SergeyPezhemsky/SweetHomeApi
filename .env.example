SWEETHOME_API_IMAGE=ghcr.io/your-github-username/sweethomeapi:latest
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5000

POSTGRES_DB=sweethome
POSTGRES_USER=sweethome
POSTGRES_PASSWORD=change-this-password

HOMEASSISTANT_BASE_URL=http://homeassistant.local:8123
HOMEASSISTANT_ACCESS_TOKEN=change-this-token
HOMEASSISTANT_REQUEST_TIMEOUT_SECONDS=60

SWEETHOME_API_IMAGE=ghcr.io/your-github-username/sweethomeapi:latest
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5000

POSTGRES_DB=sweethome
POSTGRES_USER=sweethome
POSTGRES_PASSWORD=change-this-password

HOMEASSISTANT_BASE_URL=http://homeassistant.local:8123
HOMEASSISTANT_ACCESS_TOKEN=change-this-token
HOMEASSISTANT_REQUEST_TIMEOUT_SECONDS=60

# Swagger в Production выключен; true — включить.
SWAGGER_ENABLED=false

# Удаление фона у фото гардероба (контейнер flatlay, ~1.2 ГБ образ; пик ~1.2 ГБ RAM при старте, ~0.5 ГБ в работе).
# Пустое значение (FLATLAY_BASE_URL=) выключает обработку — фото остаются как загружены.
FLATLAY_BASE_URL=http://flatlay:8000
FLATLAY_MEM_LIMIT=1536m

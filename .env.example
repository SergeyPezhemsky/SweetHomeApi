SWEETHOME_API_IMAGE=ghcr.io/your-github-username/sweethomeapi:latest
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5000

POSTGRES_DB=sweethome
POSTGRES_USER=sweethome
POSTGRES_PASSWORD=change-this-password

HOMEASSISTANT_BASE_URL=http://homeassistant.local:8123
HOMEASSISTANT_ACCESS_TOKEN=change-this-token
HOMEASSISTANT_REQUEST_TIMEOUT_SECONDS=60

# Swagger в Production выключен; true — включить.
SWAGGER_ENABLED=false

# Удаление фона у фото гардероба (контейнер flatlay, ~1.2 ГБ образ; пик ~1.2 ГБ RAM при старте, ~0.5 ГБ в работе).
# Пустое значение (FLATLAY_BASE_URL=) выключает обработку — фото остаются как загружены.
FLATLAY_BASE_URL=http://flatlay:8000
FLATLAY_MEM_LIMIT=1536m

# Распознавание чеков во вкладке «Финансы» (фото чека → сумма, позиции, категории).
# Yandex AI Studio: API-ключ сервисного аккаунта с ролью ai.languageModels.user и ID каталога.
# Пустой FINANCE_LLM_API_KEY выключает распознавание. Фото чеков отправляются провайдеру.
FINANCE_LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
FINANCE_LLM_API_KEY=
# Api-Key — для Yandex AI Studio; для других OpenAI-совместимых провайдеров обычно Bearer.
FINANCE_LLM_AUTH_SCHEME=Api-Key
# ID каталога Yandex Cloud (обязателен для Yandex: без него распознавание не включится).
FINANCE_LLM_PROJECT=
FINANCE_LLM_MODEL=qwen3.6-35b-a3b

# Порядок провайдеров распознавания: openai (OpenAI-совместимый, выше — Yandex) и anthropic.
# Первый — основной; следующий вызывается, если первый недоступен или не смог прочитать чек.
FINANCE_LLM_ORDER=openai,anthropic

# Anthropic (Claude). Пустой ключ выключает провайдер.
# Anthropic не обслуживает Россию: с российского VPS укажите прокси за её пределами
# (http://user:pass@host:port или socks5://host:port) — он используется только для запросов к Anthropic.
FINANCE_ANTHROPIC_API_KEY=
FINANCE_ANTHROPIC_MODEL=claude-haiku-5-5
FINANCE_ANTHROPIC_PROXY=
# Рассуждения модели: auto выбирает по модели (Haiku — disabled, Sonnet — between_tools, Opus — всегда включены).
# Можно задать явно: disabled / between_tools / adaptive. Effort (low/medium/high) — глубина рассуждений, пусто — по умолчанию.
FINANCE_ANTHROPIC_THINKING=auto
FINANCE_ANTHROPIC_EFFORT=
